{
  "ServerOptions": {
    "Urls": "http://*:8080",
    "HostName": "smtp4dev",
    "Port": 2525,
    "AllowRemoteConnections": true,
    "Database": "",
    "LockSettings": true,
    "NumberOfMessagesToKeep": 100,
    "NumberOfSessionsToKeep": 100,
    "TlsMode": "None",
    "AuthenticationRequired": false,
    "SmtpAllowAnyCredentials": false,
    "SmtpEnabledAuthTypesWhenNotSecureConnection": "",
    "SmtpEnabledAuthTypesWhenSecureConnection": "",
    "SecureConnectionRequired": false,
    "WebAuthenticationRequired": false,
    "ImapPort": null,
    "Pop3Port": null,
    "DisableMessageSanitisation": false,
    "DeliverToStdout": "",
    "MaxMessageSize": 524288,
    "Users": [],
    "Mailboxes": []
  },
  "RelayOptions": {
    "SmtpServer": "",
    "AutomaticEmails": [],
    "AutomaticRelayExpression": "",
    "SenderAddress": "",
    "Login": "",
    "Password": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Filter": [
      {
        "Name": "ByIncludingOnly",
        "Args": {
          "expression": "@x is null and (@mt = 'Using in-memory database for message storage' or @mt = 'SMTP Server is listening on port {smtpPortNumber} ({address}) with TLS mode ({tlsMode}).' or @mt = 'Keeping last {messagesToKeep} messages per mailbox and {sessionsToKeep} sessions.' or @mt = 'SMTP server stopped.' or @mt = 'SMTP server stopping...' or @mt = 'Exiting' or @mt = 'smtp4dev version {version}')"
        }
      }
    ],
    "WriteTo": []
  }
}
